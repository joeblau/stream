{
  "name": "stream-interviews",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "typegen": "wrangler types --include-runtime false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:client": "node --test test/browser/reference-host-client.mjs",
    "test:browser": "node test/browser/reference-host-browser.mjs",
    "build": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261002.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0",
    "ws": "8.21.0"
  }
}
